# Settings for the Borealis Party service. Copied to /etc/borealis-party/server.env on install.

# Address and port to listen on.
BOREALIS_BIND=0.0.0.0:8787

# true: anyone who can reach the server can create an account, including a Dungeon Master account
# (which can make the server download content from https addresses).
# false: accounts are made with: borealis-server add-user <name> <dm|player>
BOREALIS_OPEN_REGISTRATION=true

# Largest upload in megabytes (a zip of a 5etools data folder can be large).
BOREALIS_MAX_UPLOAD_MB=512

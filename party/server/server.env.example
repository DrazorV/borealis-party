# Environment for the Borealis Connect service, copied to /etc/borealis-party/server.env on install.
# Settings live in /var/lib/borealis-party/config.toml (written on first start). Any of them can be set here
# instead as BOREALIS__<SECTION>__<KEY>; put passwords here rather than in config.toml.

# BOREALIS__SERVER__BIND=0.0.0.0:8787
# BOREALIS__SERVER__OPEN_REGISTRATION=false
# Behind a reverse proxy on this machine or the network, list it, or sign-up and sign-in limits treat every client
# as the proxy (party/README.md, "Security and proxies"). Commas between entries:
# BOREALIS__SERVER__TRUSTED_PROXIES=127.0.0.1

# The first admin, created only while the server has no accounts:
# BOREALIS__INITIAL_ADMIN__USERNAME=admin
# BOREALIS__INITIAL_ADMIN__PASSWORD=
# Sign-up email (optional):
# BOREALIS__SERVER__PUBLIC_URL=https://party.example.com
# BOREALIS__SMTP__HOST=smtp.example.com
# BOREALIS__SMTP__USER=party@example.com
# BOREALIS__SMTP__PASSWORD=
# BOREALIS__SMTP__FROM=Borealis Connect <party@example.com>

# PostgreSQL instead of the SQLite file:
# BOREALIS__DATABASE__TYPE=postgres
# BOREALIS__POSTGRES__HOST=localhost
# BOREALIS__POSTGRES__PORT=5432
# BOREALIS__POSTGRES__USER=borealis
# BOREALIS__POSTGRES__PASSWORD=
# BOREALIS__POSTGRES__DATABASE=borealis_party
